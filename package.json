{
  "name": "danaital-site",
  "version": "1.0.0",
  "private": true,
  "description": "Tal Danai's personal website — TypeScript compiled to static JS for GitHub Pages.",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "minify": "esbuild _site/assets/data.js _site/assets/main.js _site/assets/theme-init.js --minify --outdir=_site/assets --allow-overwrite && esbuild _site/assets/styles.css --minify --outfile=_site/assets/styles.css --allow-overwrite"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "5.6.3"
  }
}
